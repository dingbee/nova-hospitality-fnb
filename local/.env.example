# NOVA Hospitality — Restaurant & Bar OS — local runtime configuration
#
# Copy to local/.env and fill in. This file holds RUNTIME SECRETS only.
# Product defaults live in src/modules/restaurant/core/product.ts.
# Property configuration (name, currency, timezone, outlets) is created by the
# first-run bootstrap and stored in the database — never here.
#
# NOTHING IN THIS FILE IS EVER BUNDLED INTO THE BROWSER.

# ---------- PostgreSQL ----------
NOVA_DB_HOST=127.0.0.1
NOVA_DB_PORT=5432
NOVA_DB_NAME=nova_local
NOVA_DB_SUPERUSER=nova_superuser
NOVA_DB_SUPERUSER_PASSWORD=
# Role PostgREST logs in as; it can only SET ROLE to anon/authenticated/service_role.
NOVA_DB_AUTHENTICATOR=nova_authenticator
NOVA_DB_AUTHENTICATOR_PASSWORD=

# ---------- PostgREST ----------
NOVA_POSTGREST_PORT=3001
# Bind PostgREST to loopback only. The LAN talks to the gateway, never to
# PostgREST or PostgreSQL directly.
NOVA_POSTGREST_HOST=127.0.0.1
NOVA_POSTGREST_SCHEMAS=public,storage

# ---------- Local auth / gateway ----------
# HS256 secret shared by the local auth issuer and PostgREST. Minimum 32 chars.
# Generate with: openssl rand -base64 48
NOVA_JWT_SECRET=
NOVA_JWT_ACCESS_TTL_SECONDS=3600
NOVA_JWT_REFRESH_TTL_SECONDS=2592000
# The gateway is the only LAN-exposed surface.
NOVA_GATEWAY_HOST=0.0.0.0
NOVA_GATEWAY_PORT=8000

# ---------- Application runtime ----------
NOVA_RUNTIME_MODE=local
# The browser terminals point at the gateway.
VITE_SUPABASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_PUBLISHABLE_KEY=nova-local-anon
SUPABASE_URL=http://127.0.0.1:8000
SUPABASE_PUBLISHABLE_KEY=nova-local-anon

# ---------- Backups ----------
NOVA_BACKUP_DIR=./local/backups