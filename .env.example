# NOVA Hospitality F&B — application environment.
# The appliance generates its own values in standalone/.env; this file documents
# the contract for hosted or CI runs. No value here may point at another product.

VITE_NOVA_RUNTIME_MODE=local          # local | hosted
VITE_SUPABASE_URL=https://localhost:8443
VITE_SUPABASE_PUBLISHABLE_KEY=nova-local-anon
SUPABASE_URL=https://localhost:8443
SUPABASE_PUBLISHABLE_KEY=nova-local-anon

# Optional: promote a specific existing account to OWNER on first migration.
NOVA_BOOTSTRAP_OWNER_EMAIL=

# Optional WAN capabilities. Absent = capability reported unavailable, never faked.
NOVA_EMAIL_WEBHOOK_URL=
NOVA_EMAIL_WEBHOOK_KEY=
NOVA_EMAIL_FROM=no-reply@nova-hospitality.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_FROM=
NOVA_AI_GATEWAY_URL=
NOVA_AI_MODEL=
NOVA_AI_API_KEY=
