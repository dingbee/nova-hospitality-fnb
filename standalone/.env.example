# ==========================================================================
# Restaurant & Bar OS — STANDALONE LOCAL RUNTIME
# Copy to standalone/.env. Nothing here touches any hosted environment.
# ==========================================================================

NOVA_PRODUCT=restaurant-bar-os
NOVA_STANDALONE=true

# ---- Database (Docker Compose, audited port 55432) -----------------------
NOVA_DB_HOST=127.0.0.1
NOVA_DB_PORT=55432
NOVA_DB_NAME=nova_fnb
NOVA_DB_SUPERUSER=nova_superuser
NOVA_DB_SUPERUSER_PASSWORD=change-me-locally
NOVA_DB_AUTHENTICATOR=nova_authenticator
NOVA_DB_AUTHENTICATOR_PASSWORD=change-me-locally
PGSSLMODE=disable

# ---- Data API (PostgREST, audited port 53000) ----------------------------
NOVA_POSTGREST_HOST=127.0.0.1
NOVA_POSTGREST_PORT=53000
NOVA_POSTGREST_SCHEMAS=public,storage

# ---- Application gateway (audited HTTPS port 8443) -----------------------
NOVA_GATEWAY_HOST=0.0.0.0
NOVA_GATEWAY_PORT=53080
NOVA_GATEWAY_TLS_PORT=8443
NOVA_TLS_MODE=auto
NOVA_TLS_IPS=127.0.0.1
NOVA_TLS_HOSTS=localhost

# ---- Standalone schema + synthetic demo data -----------------------------
NOVA_MIGRATIONS_DIR=./standalone/db/migrations
NOVA_SEED_DIR=./standalone/db/seed/demo
NOVA_DEMO_SEED=true

# ---- Runtime state kept OUT of the source tree (4F precaution) -----------
NOVA_KEY_DIR=${HOME}/.nova-fnb/keys
NOVA_RUN_DIR=${HOME}/.nova-fnb/run
NOVA_BACKUP_DIR=${HOME}/.nova-fnb/backups
NOVA_STORAGE_DIR=${HOME}/.nova-fnb/storage

# ---- Client-side backend target (LOCAL sentinels only) -------------------
# These must never contain a hosted URL or key.
VITE_SUPABASE_URL=http://127.0.0.1:53000
VITE_SUPABASE_PUBLISHABLE_KEY=nova-local-anon
VITE_SUPABASE_PROJECT_ID=nova-local

# ---- Hospitality bridge (standalone = no PMS) ----------------------------
# Room-charge tender and hotel guest lookups are disabled without a PMS.
VITE_FNB_PMS_FOLIO=off
VITE_FNB_GUEST_PROFILE=local
